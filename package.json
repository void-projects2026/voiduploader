{
  "name": "despair-downloader",
  "version": "2.0.1",
  "description": "Despair World desktop uploader: upload anime episodes to EarnVid / Doodstream / Voe in parallel, with auto-update.",
  "main": "src/main.js",
  "author": "despair-world",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "axios": "^1.7.7",
    "form-data": "^4.0.0"
  },
  "build": {
    "appId": "com.despairworld.downloader",
    "productName": "Despair Downloader",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "void-projects2026",
      "repo": "voiduploader"
    }
  }
}
