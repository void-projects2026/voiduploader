{
  "name": "despair-downloader",
  "version": "2.1.0",
  "description": "Despair World desktop uploader: upload anime episodes to EarnVid / Doodstream / Voe in parallel, with auto-update.",
  "main": "src/main.js",
  "author": "despair-world",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder --win --publish never",
    "release": "npm run build:renderer && electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^3.4.15",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "axios": "^1.7.7",
    "form-data": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.462.0"
  },
  "build": {
    "appId": "com.despairworld.downloader",
    "productName": "Despair Downloader",
    "electronVersion": "31.7.7",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main.js",
      "src/preload.js",
      "src/lib/**/*",
      "src/renderer/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "void-projects2026",
      "repo": "voiduploader"
    }
  }
}
