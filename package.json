{
  "name": "doodstream-uploader",
  "version": "1.0.0",
  "description": "voidzone internal tool: bulk upload anime episode video files to DoodStream / EarnVid",
  "main": "src/main.js",
  "author": "voidzone",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "axios": "^1.7.7",
    "form-data": "^4.0.0"
  },
  "build": {
    "appId": "com.voidzone.doodstream-uploader",
    "productName": "VoidZone Uploader",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
